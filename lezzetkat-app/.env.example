# Bu dosyayı ".env" adıyla kopyalayıp değerleri doldur.
# Supabase değerleri boşsa uygulama cihaz içi DEMO modunda çalışır (veriler yalnızca o cihazda kalır).
# Supabase panelinde: Project Settings → API → Project URL ve "anon public" anahtarı.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Paylaşılan ilan bağlantılarının kök adresi (web sürümünü yayınladığın alan adı)
EXPO_PUBLIC_SHARE_BASE_URL=https://www.lezzetkat.com

# Destek ve KVKK başvuruları için e-posta adresi
EXPO_PUBLIC_SUPPORT_EMAIL=ozbek.info@gmail.com

# Online ödeme (iyzico) anahtarları uygulamaya DEĞİL, Supabase gizli değerlerine girilir:
#   npx supabase secrets set IYZICO_API_KEY=... IYZICO_SECRET_KEY=... IYZICO_BASE_URL=https://sandbox-api.iyzipay.com APP_RETURN_URLS="lezzetkat://,exp://,https://www.lezzetkat.com/"
# Ayrıntılar: README → "Online ödeme: iyzico kurulumu"
