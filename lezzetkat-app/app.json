{
  "expo": {
    "name": "LezzetKAT",
    "slug": "lezzetkat",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.lezzetkat.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.lezzetkat.app",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "name": "LezzetKAT",
      "themeColor": "#1F5E57",
      "backgroundColor": "#FAF7F2"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "İlan ve profil fotoğrafı seçmek için galerinize erişim gerekiyor.",
          "cameraPermission": "İlan ve profil fotoğrafı çekmek için kameranıza erişim gerekiyor.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 260,
          "resizeMode": "contain",
          "backgroundColor": "#FAF7F2"
        }
      ],
      "expo-sharing",
      "expo-web-browser"
    ],
    "scheme": "lezzetkat",
    "primaryColor": "#1F5E57",
    "experiments": {
      "typedRoutes": false
    },
    "description": "Türkiye’nin ev yemekleri pazaryeri: il, ilçe ve mahalle bazında randevulu sipariş, online ödeme, kurye ve kargo."
  }
}
