{
  "expo": {
    "name": "LezzetHub",
    "slug": "lezzethub",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.lezzethub.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FAF7F2",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.lezzethub.app",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "name": "LezzetHub",
      "themeColor": "#1F5E57",
      "backgroundColor": "#FAF7F2"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "İlan ve profil fotoğrafı seçmek için galerinize erişim gerekiyor.",
          "cameraPermission": "İlan ve profil fotoğrafı çekmek için kameranıza erişim gerekiyor.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#FAF7F2"
        }
      ],
      "expo-sharing"
    ],
    "scheme": "lezzethub",
    "primaryColor": "#1F5E57",
    "experiments": {
      "typedRoutes": false
    },
    "description": "Hatay’ın ev yemekleri pazaryeri: ilçe ve mahalle bazında randevulu sipariş."
  }
}
