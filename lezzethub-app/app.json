{
  "expo": {
    "name": "LezzetHub",
    "slug": "lezzethub",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.lezzethub.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#fffaf5",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.lezzethub.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "name": "LezzetHub",
      "themeColor": "#ea580c",
      "backgroundColor": "#fffaf5"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "İlan ve profil fotoğrafı seçmek için galerinize erişim gerekiyor.",
          "cameraPermission": "İlan ve profil fotoğrafı çekmek için kameranıza erişim gerekiyor."
        }
      ]
    ],
    "scheme": "lezzethub",
    "primaryColor": "#ea580c",
    "experiments": {
      "typedRoutes": false
    }
  }
}
